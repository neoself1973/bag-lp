---
import BaseLayout from "../layouts/BaseLayout.astro";

// 共通パーツ（全商材共通・文言固定）
import Header           from "../components/common/Header.astro";
import CtaBlock         from "../components/common/CtaBlock.astro";
import StickyFooter     from "../components/common/StickyFooter.astro";
import SiteFooter       from "../components/common/SiteFooter.astro";
import BackToTop        from "../components/common/BackToTop.astro";
import BuyFlow          from "../components/common/BuyFlow.astro";
import Features         from "../components/common/Features.astro";
import HighPriceReasons from "../components/common/HighPriceReasons.astro";
import WhyHighPrice     from "../components/common/WhyHighPrice.astro";
import Promise          from "../components/common/Promise.astro";
import IdRequired       from "../components/common/IdRequired.astro";
import StoreInfo        from "../components/common/StoreInfo.astro";
import Category         from "../components/common/Categories.astro";

// バッグ専用パーツ
import BagHero         from "../components/bag/BagHero.astro";
import BagBanner       from "../components/bag/BagBanner.astro";
import BagCampaign     from "../components/bag/BagCampaign.astro";
import BagState        from "../components/bag/BagState.astro";
import BagBrands       from "../components/bag/BagBrands.astro";
import BagRecords      from "../components/bag/BagRecords.astro";
import BagTypeList     from "../components/bag/BagTypeList.astro";
import BagBuyList      from "../components/bag/BagBuyList.astro";
import BagSellTips     from "../components/bag/BagSellTips.astro";
import BagCrossSell    from "../components/bag/BagCrossSell.astro";
import BagTestimonials from "../components/bag/BagTestimonials.astro";
import BagFaq          from "../components/bag/BagFaq.astro";

// WordPressメディアのベースURL
const WP_BASE = "http://xs361374.xsrv.jp/wp-content/uploads/2026/06";

// ヒーロー背景（日本語ファイル名を encodeURI で安全な形に変換）
const heroBg = encodeURI(
  `${WP_BASE}/ファーストビュー背景てすと-1-1.png`
);
---

<BaseLayout>
  <Header />

  <main>
    <!-- 1. ファーストビュー -->
    <BagHero bgImage={heroBg} />

    <!-- 2. アピールバナー -->
    <BagBanner />

    <!-- 3. 特徴 -->
    <Features />

    <!-- 4. 買取点数リスト -->
    <BagBuyList />

    <!-- 5. キャンペーン -->
    <BagCampaign />

    <!-- 6. CTA（電話・LINE） -->
    <CtaBlock />

    <!-- 7. 参考買取実績 -->
    <BagRecords wpBase={WP_BASE} />

    <!-- 8. こんな状態でも買取OK -->
    <BagState />

    <!-- 9. 買取強化中ブランド -->
    <BagBrands />

    <!-- 10. 売り方のコツ・ポイント -->
    <BagSellTips />

    <!-- 11. バッグの種類・参考価格リスト -->
    <BagTypeList />

    <!-- 12. CTA（電話・LINE） -->
    <CtaBlock />

    <!-- 13. 他カテゴリへの導線 -->
    <BagCrossSell />

    <!-- 14. なぜ高く買えるか -->
    <WhyHighPrice />

    <!-- 15. 出張買取の流れ -->
    <BuyFlow />

    <!-- 16. 本人確認について -->
    <IdRequired />

    <!-- 17. 高価買取の理由 -->
    <HighPriceReasons />

    <!-- 18. まさ吉の約束 -->
    <Promise />

    <!-- 19. 店舗情報 -->
    <StoreInfo />

    <!-- 20. お客様の声 -->
    <BagTestimonials />

    <!-- 21. カテゴリ一覧 -->
    <Category />

    <!-- 22. よくある質問 -->
    <BagFaq />

    <!-- 23. CTA（電話・LINE） -->
    <CtaBlock />
  </main>

  <SiteFooter />
  <StickyFooter />
  <BackToTop />
</BaseLayout>