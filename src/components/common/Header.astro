---
// src/components/Header.astro
// 15種類のLPで使い回せる、可変式・完全レスポンシブ固定ヘッダー

interface Props {
  catchphrase?: string; // 商材ごとのキーワードキャッチコピーを受け取る設定
}

// 呼び出し側で指定がない場合のデフォルト文言を設定
const { catchphrase = "金・プラチナ・ブランド品を高く売るなら" } = Astro.props;
---

<header 
  id="masakichi-sticky-header" 
  class="fixed top-0 left-0 right-0 z-[99999] bg-[#1A3B22] shadow-[0_2px_10px_rgba(0,0,0,0.45)] transition-transform duration-350 ease-out font-sans translate-y-0"
>
  <div class="w-full max-w-[500px] md:max-w-7xl mx-auto flex items-center justify-between h-16 px-3 md:px-6">

    <div class="flex flex-col items-start justify-center min-w-0">
      <span class="text-[10px] text-gray-300 whitespace-nowrap leading-none mb-1 font-medium tracking-wider">
        {catchphrase}
      </span>
      <a href="/" class="block leading-none" aria-label="買取まさ吉 ホームへ戻る">
        <div class="h-9 px-3 bg-white/5 border border-dashed border-white/20 rounded flex items-center justify-center text-white/40 text-[11px] font-bold">
          まじめな買取屋 まさ吉
        </div>
      </a>
    </div>

    <div class="flex items-stretch h-full">
      
      <a href="/shop-buy/" class="relative overflow-hidden flex flex-col items-center justify-center px-4 md:px-6 gap-1 bg-gradient-to-b from-[#2e6b3e] via-[#1a4a28] to-[#122e1a] text-white border-l border-white/15 border-r border-black/30 shadow-[inset_0_1px_0_rgba(255,255,255,0.3),inset_0_-1px_0_rgba(0,0,0,0.25)] filter hover:brightness-110 active:brightness-90 transition duration-200 h-full min-w-[72px] text-center select-none" aria-label="店舗買取の詳細">
        <div class="absolute top-0 left-0 right-0 h-[48%] bg-gradient-to-b from-white/18 to-white/4 pointer-events-none"></div>
        <svg class="w-6 h-6 fill-white relative z-10" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 9l1-5h16l1 5H3zm0 0v10a1 1 0 001 1h16a1 1 0 001-1V9H3zm6 4h6"/>
          <rect x="8" y="13" width="8" height="4" rx="0.5"/>
        </svg>
        <span class="text-[11px] font-bold whitespace-nowrap tracking-wider relative z-10">店舗買取</span>
      </a>

      <a href="/visit-buy/" class="relative overflow-hidden flex flex-col items-center justify-center px-4 md:px-6 gap-1 bg-gradient-to-b from-[#2e6b3e] via-[#1a4a28] to-[#122e1a] text-white border-r border-black/30 shadow-[inset_0_1px_0_rgba(255,255,255,0.3),inset_0_-1px_0_rgba(0,0,0,0.25)] filter hover:brightness-110 active:brightness-90 transition duration-200 h-full min-w-[72px] text-center select-none" aria-label="出張買取の申し込み">
        <div class="absolute top-0 left-0 right-0 h-[48%] bg-gradient-to-b from-white/18 to-white/4 pointer-events-none"></div>
        <svg class="w-6 h-6 fill-white relative z-10" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <rect x="1" y="10" width="20" height="8" rx="2"/>
          <path d="M14 10V7a2 2 0 00-2-2H8a2 2 0 00-2 2v3"/>
          <circle cx="5.5" cy="18.5" r="1.5"/>
          <circle cx="18.5" cy="18.5" r="1.5"/>
        </svg>
        <span class="text-[11px] font-bold whitespace-nowrap tracking-wider relative z-10">出張買取</span>
      </a>

      <button 
        id="msh-hamburger-btn" 
        class="flex flex-col items-center justify-center w-14 h-full bg-[#142e1a] border-l border-white/8 cursor-pointer gap-[5px] p-0 select-none group" 
        aria-label="メニューを開く" 
        aria-expanded="false"
      >
        <span class="block w-5 h-[2px] bg-white rounded-sm transition-all duration-300 group-[.is-open]:translate-y-[7px] group-[.is-open]:rotate-45"></span>
        <span class="block w-5 h-[2px] bg-white rounded-sm transition-all duration-300 group-[.is-open]:opacity-0 group-[.is-open]:scale-x-0"></span>
        <span class="block w-5 h-[2px] bg-white rounded-sm transition-all duration-300 group-[.is-open]:-translate-y-[7px] group-[.is-open]:rotate-[-45deg]"></span>
      </button>

    </div>
  </div>
</header>

<nav 
  id="msh-drawer" 
  class="fixed top-16 right-0 w-64 max-w-full h-[calc(100vh-64px)] bg-[#1A3B22] shadow-[-4px_0_20px_rgba(0,0,0,0.5)] translate-x-full transition-transform duration-350 ease-out z-[99998] py-6" 
  aria-hidden="true"
>
  <ul>
    <li><a href="/" class="block px-7 py-3.5 text-white text-base border-b border-white/8 hover:bg-white/7 hover:text-[#7ee8a0] transition">トップ</a></li>
    <li><a href="/shop-buy/" class="block px-7 py-3.5 text-white text-base border-b border-white/8 hover:bg-white/7 hover:text-[#7ee8a0] transition">店舗買取</a></li>
    <li><a href="/visit-buy/" class="block px-7 py-3.5 text-white text-base border-b border-white/8 hover:bg-white/7 hover:text-[#7ee8a0] transition">出張買取</a></li>
    <li><a href="/contact/" class="block px-7 py-3.5 text-white text-base border-b border-white/8 hover:bg-white/7 hover:text-[#7ee8a0] transition">お問い合わせ</a></li>
  </ul>
</nav>

<div id="msh-overlay" class="fixed inset-0 bg-black/50 z-[99997] opacity-0 pointer-events-none transition-opacity duration-350 ease-out"></div>

<script>
  // Astro専用のクリーンな最適化スクリプト
  const header = document.getElementById('masakichi-sticky-header');
  const drawer = document.getElementById('msh-drawer');
  const overlay = document.getElementById('msh-overlay');
  const hamburger = document.getElementById('msh-hamburger-btn');

  if (header && drawer && overlay && hamburger) {
    let lastScrollY = window.scrollY;
    let ticking = false;
    const HIDE_THRESHOLD = 80;

    // 上下スクロールによる表示・非表示
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const current = window.scrollY;
          if (current > lastScrollY && current > HIDE_THRESHOLD) {
            header.classList.remove('translate-y-0');
            header.classList.add('-translate-y-full'); // 上に隠す
          } else {
            header.classList.remove('-translate-y-full');
            header.classList.add('translate-y-0'); // 表示する
          }
          lastScrollY = current <= 0 ? 0 : current;
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    // スワイプ操作対応
    let touchStartY = 0;
    document.addEventListener('touchstart', (e) => {
      touchStartY = e.touches[0].clientY;
    }, { passive: true });

    document.addEventListener('touchend', (e) => {
      const diff = touchStartY - e.changedTouches[0].clientY;
      if (Math.abs(diff) < 30) return;
      if (diff > 0 && window.scrollY > HIDE_THRESHOLD) {
        header.classList.remove('translate-y-0');
        header.classList.add('-translate-y-full');
      } else if (diff < 0) {
        header.classList.remove('-translate-y-full');
        header.classList.add('translate-y-0');
      }
    }, { passive: true });

    // ドロワー開閉処理
    function openDrawer() {
      drawer.classList.remove('translate-x-full');
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      hamburger.classList.add('is-open');
      hamburger.setAttribute('aria-expanded', 'true');
      drawer.setAttribute('aria-hidden', 'false');
    }

    function closeDrawer() {
      drawer.classList.add('translate-x-full');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      hamburger.classList.remove('is-open');
      hamburger.setAttribute('aria-expanded', 'false');
      drawer.setAttribute('aria-hidden', 'true');
    }

    hamburger.addEventListener('click', () => {
      if (hamburger.classList.contains('is-open')) {
        closeDrawer();
      } else {
        openDrawer();
      }
    });

    overlay.addEventListener('click', closeDrawer);
    drawer.querySelectorAll('a').forEach(link => link.addEventListener('click', closeDrawer));
  }
</script>