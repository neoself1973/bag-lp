---
// src/components/BackToTop.astro
// 全LP共通の「上に戻る」ボタン
---

<button 
  id="back-to-top" 
  aria-label="ページの上部へ戻る"
  class="fixed bottom-[90px] right-[20px] sm:right-[calc(50%-230px)] w-[44px] h-[44px] rounded-full bg-white text-[#333333] flex items-center justify-center shadow-[0_2px_10px_rgba(0,0,0,0.15)] hover:bg-[#f5f5f5] opacity-0 invisible translate-y-2.5 transition-all duration-300 ease-out z-[9999] cursor-pointer"
>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-[18px] h-[18px] block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
    <line x1="12" y1="19" x2="12" y2="5"></line>
    <polyline points="5 12 12 5 19 12"></polyline>
  </svg>
</button>

<script>
  // Astro専用の軽量スクリプト
  const btn = document.getElementById('back-to-top');

  if (btn) {
    // スクロール時の表示切り替え（300px以上で表示）
    window.addEventListener('scroll', () => {
      if (window.scrollY > 300) {
        // 表示するクラスを付与し、隠すクラスを外す
        btn.classList.remove('opacity-0', 'invisible', 'translate-y-2.5');
        btn.classList.add('opacity-100', 'visible', 'translate-y-0');
      } else {
        // 隠すクラスを付与し、表示するクラスを外す
        btn.classList.remove('opacity-100', 'visible', 'translate-y-0');
        btn.classList.add('opacity-0', 'invisible', 'translate-y-2.5');
      }
    }, { passive: true });

    // クリックでページ上部へスムーススクロール
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>