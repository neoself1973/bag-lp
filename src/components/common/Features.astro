---
// src/components/Features.astro
// 共通：4つの強み（特徴）セクション
---

<section class="max-w-[500px] mx-auto px-2.5 py-4 font-serif">
  
  <div class="relative bg-white py-4 pl-10 pr-2.5 mt-[1px] mb-5 text-center shadow-[0_4px_10px_rgba(0,0,0,0.08)] before:content-[''] before:absolute before:inset-[5px] before:border-y before:border-[#d4c498] before:pointer-events-none">
    
    <div class="absolute top-2.5 -left-4 bg-[radial-gradient(circle,#c7a93c,#9e8222)] text-white w-[75px] h-[75px] rounded-full flex flex-col justify-center items-center Skinner line-high-[1.1] -rotate-12 shadow-[2px_3px_6px_rgba(0,0,0,0.2)] z-10">
      <span class="text-[11px] font-bold font-sans">当日査定</span>
      <span class="text-[26px] font-bold">OK</span>
    </div>
    
    <div class="relative z-0">
      <div class="text-[#8f7528] text-xs font-bold tracking-wider">
        <span class="text-[#c7a93c] font-bold">\</span> 今が売り時！ <span class="text-[#c7a93c] font-bold">/</span>
      </div>
      <h2 class="text-[#8f7528] text-2xl font-black my-1 tracking-[1.5px]">
        買取価格相場変動中
      </h2>
      <p class="text-[#8f7528] text-[11px] font-bold m-0 inline-block border-t border-[#d4c498] pt-1">
        相場が知りたい方はご相談ください！
      </p>
    </div>
  </div>

  <div class="flex items-end md:items-center gap-2.5 md:gap-8">
    
    <div class="basis-[38%] md:basis-[30%] shrink-0">
      <img 
        src="http://xs361374.xsrv.jp/wp-content/uploads/2026/06/楽天カードマン-removebg-preview.png" 
        alt="査定員" 
        class="w-full h-auto block"
      />
    </div>

    <div class="flex-1 bg-white/95 rounded-md px-4 py-2.5 shadow-[0_4px_10px_rgba(0,0,0,0.08)]">
      
      <div class="flex items-center justify-between py-3 border-b border-[#e0d5ba] text-[#8f7528]">
        <div class="text-xs font-bold leading-[1.3] flex-1">査定時間</div>
        <div class="text-[10px] font-bold leading-[1.2] text-right mr-2 font-sans">最短<br>最速</div>
        <div class="flex items-baseline justify-end min-w-[50px] font-sans">
          <span class="text-[34px] font-bold leading-none">5</span>
          <span class="text-e text-base font-bold ml-0.5">分</span>
        </div>
      </div>

      <div class="flex items-center justify-between py-3 border-b border-[#e0d5ba] text-[#8f7528]">
        <div class="text-xs font-bold leading-[1.3] flex-1">無料<br>出張買取</div>
        <div class="text-[10px] font-bold leading-[1.2] text-right mr-2 font-sans">最短<br>即日</div>
        <div class="flex items-baseline justify-end min-w-[50px] font-sans">
          <span class="text-[34px] font-bold leading-none">25</span>
          <span class="text-base font-bold ml-0.5">分</span>
        </div>
      </div>

      <div class="flex items-center justify-between py-3 border-b border-[#e0d5ba] text-[#8f7528]">
        <div class="text-xs font-bold leading-[1.3] flex-1">アクセス<br>良好！</div>
        <div class="flex items-center justify-end">
          <span class="text-[26px] font-bold leading-none">駅近</span>
          <span class="text-[10px] font-bold leading-[1.1] text-center ml-1.5">店舗<br>多数</span>
        </div>
      </div>

      <div class="flex items-center justify-between py-3 text-[#8f7528]">
        <div class="text-xs font-bold leading-[1.3] flex-1">1000万円超<br>でも</div>
        <div class="flex items-center justify-end">
          <span class="text-[10px] font-bold leading-[1.1] text-center mr-1.5">即<br>日</span>
          <span class="text-[26px] font-bold leading-none">現金化</span>
        </div>
      </div>

    </div>
  </div>

</section>