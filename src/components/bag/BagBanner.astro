---
// BagBanner.astro
// ヒーロー下などに使うアピールバナー（直営3店舗 / 顧客に徹底還元）
---

<div class="flex w-full max-w-[500px] mx-auto bg-gradient-to-b from-[#2b5c3a] to-[#1a3a23] border-t-2 border-[#CBAA5C]">

  <!-- 左側：直営3店舗 -->
  <div class="flex-1 flex flex-col items-center justify-center text-center px-1.5 py-[15px] border-r border-white/30">
    <p class="text-[0.85rem] font-bold text-white leading-snug tracking-[0.5px] mb-1.5">
      岡山・倉敷エリア密着
    </p>
    <div class="flex items-baseline justify-center leading-none text-white">
      <span class="text-[1.6rem] font-black">直営</span>
      <span class="text-[1.8rem] font-black text-[#FFF100] mx-0.5">3</span>
      <span class="text-[1rem] font-bold">店舗</span>
    </div>
  </div>

  <!-- 右側：顧客に徹底還元 -->
  <div class="flex-1 flex flex-col items-center justify-center text-center px-1.5 py-[15px]">
    <p class="text-[0.85rem] font-bold text-white leading-snug tracking-[0.5px] mb-1.5">
      AI×プロの査定×直営で
    </p>
    <p class="text-[1.3rem] font-black text-[#FFF100] leading-snug tracking-[1px] m-0">
      顧客に徹底還元
    </p>
  </div>

</div>